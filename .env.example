
# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_bucket_name

# GitHub Integration
GITHUB_TOKEN=your_github_token
GITHUB_REPO=betvages23/betvages23.in
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# FCC SSO Configuration
FCC_CLIENT_ID=your_fcc_client_id
FCC_CLIENT_SECRET=your_fcc_client_secret
FCC_REDIRECT_URI=https://your-domain.replit.app/auth/callback

# Application
NODE_ENV=production
PORT=5000
API_KEY=your_api_key_for_external_connections
