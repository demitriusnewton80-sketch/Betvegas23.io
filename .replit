[[workflows.workflow.tasks]]
task = "shell.exec"
args = "curl -s http://0.0.0.0:5000/streaming/workflows/all"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"4. Sportsbook:\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "curl -s http://0.0.0.0:5000/sportsbook/games | jq '.games | length' || echo \"Sportsbook check\""

[[workflows.workflow.tasks]]
task = "shell.exec"
