[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"Step 2: Deep system clean...\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "rm -rf node_modules/.cache"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "rm -rf dist"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "rm -rf .cache"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"Cache cleared\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"Step 3: Fresh dependency installation...\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm cache clean --force"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"\""

[[workflows.workflow.tasks]]
task = "shell.exec"
