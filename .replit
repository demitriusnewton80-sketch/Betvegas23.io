[[workflows.workflow]]
name = "Verify All Systems"
author = 48739577
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"=== System Verification ===\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"FCC Entity: 20130314143016\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"Checking all critical endpoints...\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"1. Health Status:\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "curl -s http://0.0.0.0:5000/health"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"2. Core Status:\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "curl -s http://0.0.0.0:5000/api/core/status"

