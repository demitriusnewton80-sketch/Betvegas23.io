[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Run"

run = "npm run dev"

[deployment]
run = ["sh", "-c", "npm run dev"]

[[ports]]
localPort = 5000
externalPort = 80

[[workflows.workflow]]
name = "Run"
author = 48739577
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm install"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[[workflows.workflow]]
name = "Quick Service Restart"
author = 48739577
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"=== Quick Service Restart ===\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"FCC Entity: 20130314143016\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f \"npm run dev\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 2"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev &"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 5"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"✅ Services restarted\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "curl -s http://0.0.0.0:5000/health"

[[workflows.workflow]]
name = "System Diagnostics"
author = 48739577
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"=== Young Meeat LLC System Diagnostics ===\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"FCC Entity: 20130314143016\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "curl -s http://0.0.0.0:5000/health"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "curl -s http://0.0.0.0:5000/api/core/status"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsc --noEmit"

[[workflows.workflow]]
name = "FCC Contact Info"
author = 48739577
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"==================================\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"Young Meeat LLC - FCC Entity\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"FCC Entity: 20130314143016\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"FCC Registration: 0024454324\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"Contact: gbemeeat@gmail.com\""

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "echo \"==================================\""